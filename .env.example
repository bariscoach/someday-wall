# Supabase → Project Settings → API
# Never commit the real values. Put them in Vercel → Settings → Environment Variables,
# and in a local .env.local file for `vercel dev`.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row level security and must
# only ever be used server-side (these /api functions). Never expose it in the browser.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
